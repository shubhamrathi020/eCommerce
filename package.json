    "db:studio": "prisma studio --config apps/api/prisma.config.ts --schema apps/api/prisma/schema.prisma",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "verify": "nx run-many -t lint test build",
    "e2e": "nx e2e storefront-e2e",
    "mock-data": "node tools/generate-mock-data/generate.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "k8s:render": "kubectl kustomize deploy/k8s/base"
